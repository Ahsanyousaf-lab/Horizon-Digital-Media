{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array" },
        "tools": { "type": "array" },
        "client": { "type": "string" },
        "year": { "type": "string" },
        "heroImage": { "type": "string" },
        "images": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Client contact or service inquiry submitted via website forms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "serviceType": { "type": "string" },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["fullName", "email", "serviceType", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects collection readable by all visitors and manageable by admin"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Contact form submissions and service inquiries submitted by clients"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators record"
    }
  }
}
